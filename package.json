{
  "name": "pi-brand",
  "version": "0.1.0",
  "description": "Name apps fast: generate candidates with the agent, pick favorites in a multi-select UI, remember likes across rounds",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "branding",
    "naming"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine.ts",
    "./generation": "./src/generation.ts",
    "./checker": "./src/checker.ts",
    "./store": "./src/store.ts"
  },
  "files": [
    "src",
    "test",
    "README.md",
    "docs/ui-navigation.md",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "validate": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
